{
  "name": "shiru",
  "version": "6.10.0-beta.1",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.17.0",
  "private": true,
  "author": "RockinChaos <maintainer@shiru.app>",
  "description": "A personal anime library manager for watching and tracking your collection in real time. Lightweight, powerful, and paws-itively fast. No waiting required!",
  "main": "build/main.js",
  "homepage": "https://shiru.app/",
  "desktopName": "com.github.rockinchaos.shiru.desktop",
  "scripts": {
    "start": "cross-env NODE_ENV=development DEV_ENV=electron webpack serve",
    "web:watch": "webpack serve",
    "web:build": "cross-env NODE_ENV=production webpack build",
    "electron:start": "electron ./build/main.js",
    "build": "pnpm run web:build && electron-builder",
    "electron:build": "electron-builder",
    "publish": "pnpm run web:build && electron-builder -p always"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "client": "workspace:*",
    "common": "workspace:*",
    "electron": "45.1.0",
    "electron-builder": "^26.18.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.12",
    "concurrently": "^10.0.6"
  },
  "dependencies": {
    "@paymoapp/electron-shutdown-handler": "^1.2.0",
    "@xhayper/discord-rpc": "1.3.4",
    "utp-native": "^2.5.3"
  },
  "standard": {
    "ignore": [
      "bundle.js",
      "bundle.map.js"
    ],
    "env": [
      "browser",
      "node"
    ]
  }
}