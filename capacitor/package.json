{
  "name": "capacitor",
  "packageManager": "pnpm@10.34.1",
  "private": true,
  "scripts": {
    "build:native": "cd public/nodejs/ && docker build --build-context libnode=../../node_modules/capacitor-nodejs/android/libnode -t android-build:latest . && docker run -v ${PWD}:/app/ android-build:latest /bin/bash /app/setup-deps.sh",
    "build:native-win": "cd public\\nodejs && docker build --no-cache --build-context libnode=../../node_modules/capacitor-nodejs/android/libnode -t android-build:latest . && for %I in (.) do docker run --rm -v %~fI:/app/ -it android-build:latest /bin/bash /app/setup-deps.sh",
    "build:app": "cross-env NODE_ENV=production run-s build:native build:web && cross-env NODE_ENV=production cap sync android",
    "build:web": "webpack build",
    "build:assets": "capacitor-assets generate --iconBackgroundColor #EBEBEB --iconBackgroundColorDark #EBEBEB --splashBackgroundColor #EBEBEB --splashBackgroundColorDark #EBEBEB --android --logoSplashScale 0.3",
    "dev:ios": "cross-env NODE_ENV=development DEV_APP=ios webpack serve",
    "dev:android": "cap run android",
    "dev:android-port": "cap run android --forwardPorts 5001:5001",
    "dev:preview": "vite preview",
    "dev:start": "cross-env NODE_ENV=development DEV_APP=android webpack serve",
    "dev:webpack": "webpack serve",
    "test:e2e": "cross-env NODE_ENV=production run-s build:web dev:android"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "nodejs-mobile-gyp": "^0.4.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/toast": "^8.0.1",
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
    "capacitor-intent-uri": "^0.0.2",
    "capacitor-nodejs": "https://github.com/RockinChaos/capacitor-nodejs/releases/download/v1.0.0-beta.16/capacitor-nodejs-1.0.0-beta.16.tgz",
    "client": "workspace:*",
    "common": "workspace:*",
    "cordova-plugin-apkupdater": "^5.0.1",
    "cordova-plugin-fullscreen": "^1.3.0",
    "cordova-plugin-pip": "^0.0.2",
    "cordova-plugin-save-dialog": "^2.0.1",
    "cordova-plugin-screen-orientation": "^3.0.4",
    "cordova-plugin-secure-logger": "^1.4.17",
    "es6-promise-plugin": "^4.2.2",
    "fake-indexeddb": "^6.2.7",
    "yaml": "^2.9.1"
  }
}