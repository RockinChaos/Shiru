{
  "name": "shiru",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.34.1",
  "private": true,
  "author": "RockinChaos <RockinChaos@users.noreply.github.com>",
  "description": "A personal anime library manager for watching and tracking your collection in real time. Lightweight, powerful, and paws-itively fast. No waiting required!",
  "main": "build/main.js",
  "homepage": "https://shiru.app/",
  "standard": {
    "ignore": [
      "bundle.js",
      "bundle.map.js"
    ],
    "env": [
      "browser",
      "node"
    ]
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.69.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-svelte": "^3.23.0",
    "html-webpack-plugin": "^5.6.8",
    "semver": "^7.8.5",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "npm-run-all": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "@electron/universal": "3.0.4"
    },
    "patchedDependencies": {
      "@capacitor/local-notifications": "patches/@capacitor__local-notifications.patch",
      "@capacitor/android": "patches/@capacitor__android.patch",
      "lucide-svelte@0.455.0": "patches/lucide-svelte@0.455.0.patch",
      "rfdc": "patches/rfdc.patch",
      "svelte-keybinds": "patches/svelte-keybinds.patch",
      "cordova-plugin-apkupdater": "patches/cordova-plugin-apkupdater.patch",
      "@xhayper/discord-rpc@1.3.4": "patches/@xhayper__discord-rpc@1.3.4.patch",
      "uint8-util@2.3.2": "patches/uint8-util@2.3.2.patch"
    },
    "onlyBuiltDependencies": [
      "@paymoapp/electron-shutdown-handler",
      "bufferutil",
      "electron",
      "electron-winstaller",
      "fs-native-extensions",
      "ip-set",
      "node-datachannel",
      "sharp",
      "utf-8-validate",
      "utp-native",
      "wrtc"
    ]
  }
}
