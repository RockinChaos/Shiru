{
  "name": "shiru",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.17.0",
  "private": true,
  "author": "RockinChaos <maintainer@shiru.app>",
  "description": "A personal anime library manager for watching and tracking your collection in real time. Lightweight, powerful, and paws-itively fast. No waiting required!",
  "main": "build/main.js",
  "homepage": "https://shiru.app/",
  "scripts": {
    "lint": "eslint . --no-warn-ignored --concurrency off",
    "lint:fix": "eslint . --no-warn-ignored --concurrency off --fix",
    "typecheck": "tsc --noEmit --project jsconfig.json",
    "check:svelte": "svelte-check --no-tsconfig --threshold error --diagnostic-sources svelte,css",
    "check": "run-s lint typecheck check:svelte"
  },
  "dependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "html-webpack-plugin": "^5.6.8",
    "semver": "^7.8.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "24.13.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "npm-run-all2": "^9.0.4",
    "svelte-check": "^4.7.7",
    "typescript": "6.0.3"
  }
}